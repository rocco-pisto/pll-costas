set_global_assignment -name IP_TOOL_NAME "LPM_MULT"
set_global_assignment -name IP_TOOL_VERSION "25.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{Cyclone IV E}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "mult_16.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "mult_16_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "mult_16.inc"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "mult_16.cmp"]
